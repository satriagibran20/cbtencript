require_once '../config/cache_helpers.php';
requireRole('admin');

$db = new Database();
$conn = $db->getConnection();

/* ---------- Helper ---------- */
function dash_bulan($n) {
    $b = [1 => 'Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun', 'Jul', 'Agu', 'Sep', 'Okt', 'Nov', 'Des'];
    return $b[(int)$n] ?? '';
}
function dash_tgl($dt) {
    $t = strtotime($dt);
    if (!$t) return '-';
    return date('d', $t) . ' ' . dash_bulan(date('n', $t)) . ' ' . date('Y', $t);
}
function dash_relatif($dt) {
    $t = strtotime($dt);
    if (!$t) return '-';
    $d = time() - $t;
    if ($d < 60) return 'baru saja';
    if ($d < 3600) return floor($d / 60) . ' menit lalu';
    if ($d < 86400) return floor($d / 3600) . ' jam lalu';
    if ($d < 604800) return floor($d / 86400) . ' hari lalu';
    return dash_tgl($dt);
}
function dash_spark(array $values, $w = 92, $h = 30) {
    if (count($values) < 2) $values = [0, 0];
    $max = max($values);
    $min = min($values);
    $range = $max - $min;
    if ($range <= 0) $range = 1;
    $n = count($values);
    $pts = [];
    foreach ($values as $i => $v) {
        $x = round(($i / ($n - 1)) * $w, 1);
        $y = round($h - (($v - $min) / $range) * ($h - 5) - 2.5, 1);
        $pts[] = $x . ',' . $y;
    }
    $poly = implode(' ', $pts);
    $area = '0,' . $h . ' ' . $poly . ' ' . $w . ',' . $h;
    return '<svg class="spark" width="' . $w . '" height="' . $h . '" viewBox="0 0 ' . $w . ' ' . $h . '" fill="none" aria-hidden="true">'
        . '<polygon points="' . $area . '" fill="currentColor" opacity=".10"></polygon>'
        . '<polyline points="' . $poly . '" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></polyline>'
        . '</svg>';
}
function dash_activity_meta($text) {
    $t = mb_strtolower($text);
    if (strpos($t, 'login') !== false) return ['fa-right-to-bracket', 'indigo'];
    if (strpos($t, 'hapus') !== false) return ['fa-trash-can', 'rose'];
    if (strpos($t, 'soal') !== false) return ['fa-file-circle-plus', 'violet'];
    if (strpos($t, 'ujian') !== false) return ['fa-clipboard-check', 'emerald'];
    if (strpos($t, 'token') !== false) return ['fa-key', 'amber'];
    if (strpos($t, 'user') !== false || strpos($t, 'peserta') !== false) return ['fa-user', 'blue'];
    if (strpos($t, 'pengumuman') !== false) return ['fa-bullhorn', 'amber'];
    return ['fa-circle-info', 'slate'];
}

/* ---------- Data (cached 5 menit) ---------- */
$dash = cacheRemember('stats:admin:dashboard:v2', function () use ($conn) {
    $s = [];
    $s['total_users']     = (int)$conn->query("SELECT COUNT(*) FROM users WHERE role_id != 1")->fetchColumn();
    $s['total_exams']     = (int)$conn->query("SELECT COUNT(*) FROM exams")->fetchColumn();
    $s['active_exams']    = (int)$conn->query("SELECT COUNT(*) FROM exams WHERE status = 'aktif'")->fetchColumn();
    $s['draft_exams']     = (int)$conn->query("SELECT COUNT(*) FROM exams WHERE status = 'draft'")->fetchColumn();
    $s['completed_exams'] = (int)$conn->query("SELECT COUNT(*) FROM exams WHERE status = 'selesai'")->fetchColumn();
    $s['total_questions'] = (int)$conn->query("SELECT COUNT(*) FROM questions")->fetchColumn();
    $s['total_results']   = (int)$conn->query("SELECT COUNT(*) FROM exam_results WHERE status = 'selesai'")->fetchColumn();
    $s['avg_score']       = (float)$conn->query("SELECT COALESCE(ROUND(AVG(nilai), 1), 0) FROM exam_results WHERE status = 'selesai'")->fetchColumn();
    $s['ongoing']         = (int)$conn->query("SELECT COUNT(*) FROM exam_sessions WHERE is_active = 1")->fetchColumn();

    $series = [];
    $queries = [
        'soal'  => "SELECT DATE(created_at) d, COUNT(*) c FROM questions WHERE created_at >= DATE_SUB(CURDATE(), INTERVAL 29 DAY) GROUP BY DATE(created_at)",
        'hasil' => "SELECT DATE(created_at) d, COUNT(*) c FROM exam_results WHERE created_at >= DATE_SUB(CURDATE(), INTERVAL 29 DAY) GROUP BY DATE(created_at)",
        'users' => "SELECT DATE(created_at) d, COUNT(*) c FROM users WHERE role_id != 1 AND created_at >= DATE_SUB(CURDATE(), INTERVAL 29 DAY) GROUP BY DATE(created_at)",
        'exams' => "SELECT DATE(created_at) d, COUNT(*) c FROM exams WHERE created_at >= DATE_SUB(CURDATE(), INTERVAL 29 DAY) GROUP BY DATE(created_at)",
    ];
    foreach ($queries as $key => $sql) {
        $series[$key] = [];
        foreach ($conn->query($sql) as $r) {
            $series[$key][$r['d']] = (int)$r['c'];
        }
    }

    $composition = [];
    $rows = $conn->query("SELECT COALESCE(s.nama, 'Tanpa mapel') nama, COUNT(*) total
                          FROM questions q LEFT JOIN subjects s ON s.id = q.subject_id
                          GROUP BY COALESCE(s.nama, 'Tanpa mapel') ORDER BY total DESC");
    foreach ($rows as $r) {
        $composition[] = ['nama' => $r['nama'], 'total' => (int)$r['total']];
    }

    return ['stats' => $s, 'series' => $series, 'composition' => $composition];
}, 300);

$stats = $dash['stats'];
$series = $dash['series'];

/* ---------- Susun deret 30 hari ---------- */
$labels = [];
$soalSeries = $hasilSeries = $userSeries = $examSeries = [];
for ($i = 29; $i >= 0; $i--) {
    $d = date('Y-m-d', strtotime("-$i days"));
    $labels[]      = date('d', strtotime($d)) . ' ' . dash_bulan(date('n', strtotime($d)));
    $soalSeries[]  = $series['soal'][$d] ?? 0;
    $hasilSeries[] = $series['hasil'][$d] ?? 0;
    $userSeries[]  = $series['users'][$d] ?? 0;
    $examSeries[]  = $series['exams'][$d] ?? 0;
}
$sum = function (array $a) { return array_sum($a); };
$last7 = function (array $a) { return array_slice($a, -7); };

$newUsers = $sum($last7($userSeries));
$newSoal  = $sum($last7($soalSeries));

/* ---------- Data live ---------- */
$recent_exams = $conn->query("SELECT e.id, e.judul, e.kelas, e.status, e.waktu_mulai, e.token,
                                     COALESCE(s.nama, '-') AS subject
                              FROM exams e LEFT JOIN subjects s ON s.id = e.subject_id
                              ORDER BY e.created_at DESC, e.id DESC LIMIT 6")->fetchAll(PDO::FETCH_ASSOC);

$activities = $conn->query("SELECT l.*, u.nama FROM logs l LEFT JOIN users u ON u.id = l.user_id
                            ORDER BY l.waktu DESC LIMIT 6")->fetchAll(PDO::FETCH_ASSOC);

$announcements = $conn->query("SELECT * FROM announcements WHERE is_active = 1 ORDER BY tanggal DESC LIMIT 3")->fetchAll(PDO::FETCH_ASSOC);

$composition = $dash['composition'];
$compTotal = 0;
foreach ($composition as $c) $compTotal += $c['total'];

$statusMap = [
    'aktif'   => ['Aktif', 'aktif'],
    'selesai' => ['Selesai', 'selesai'],
    'draft'   => ['Draft', 'draft'],
];
$adminName = $_SESSION['nama'] ?? 'Admin';
$chartColors = ['#6366F1', '#10B981', '#F59E0B', '#38BDF8', '#F43F5E', '#A855F7'];
?>
