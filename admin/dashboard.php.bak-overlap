    <script>
    (function () {
        if (typeof Chart === 'undefined') return;
        var TREND = {
            labels: <?php echo json_encode($labels, JSON_UNESCAPED_UNICODE); ?>,
            soal: <?php echo json_encode($soalSeries); ?>,
            hasil: <?php echo json_encode($hasilSeries); ?>
        };
        var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        /* Tren: bar soal + line hasil */
        var trendEl = document.getElementById('trendChart');
        var trendChart = null;
        if (trendEl) {
            trendChart = new Chart(trendEl.getContext('2d'), {
                type: 'bar',
                data: {
                    labels: TREND.labels.slice(-7),
                    datasets: [
                        {
                            type: 'bar',
                            label: 'Soal baru',
                            data: TREND.soal.slice(-7),
                            backgroundColor: 'rgba(99,102,241,.72)',
                            hoverBackgroundColor: '#5B5BD6',
                            borderRadius: 6,
                            maxBarThickness: 22,
                            yAxisID: 'y'
                        },
                        {
                            type: 'line',
                            label: 'Hasil ujian',
                            data: TREND.hasil.slice(-7),
                            borderColor: '#10B981',
                            backgroundColor: 'rgba(16,185,129,.10)',
                            fill: true,
                            tension: 0.4,
                            borderWidth: 2,
                            pointRadius: 2,
                            pointHoverRadius: 5,
                            pointBackgroundColor: '#10B981',
                            yAxisID: 'y1'
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    animation: reduceMotion ? false : { duration: 300 },
                    interaction: { mode: 'index', intersect: false },
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: '#0F172A',
                            padding: 10,
                            cornerRadius: 8,
                            titleFont: { size: 12, weight: '600' },
                            bodyFont: { size: 12 },
                            displayColors: true,
                            boxPadding: 4
                        }
                    },
                    scales: {
                        x: {
                            grid: { display: false },
                            border: { display: false },
                            ticks: { color: '#94A3B8', font: { size: 11 }, maxRotation: 0, autoSkipPadding: 10 }
                        },
                        y: {
                            beginAtZero: true,
                            border: { display: false },
                            grid: { color: '#EFF2F7' },
                            ticks: { color: '#94A3B8', font: { size: 11 }, precision: 0 }
                        },
                        y1: {
                            beginAtZero: true,
                            position: 'right',
                            border: { display: false },
                            grid: { display: false },
                            ticks: { color: '#94A3B8', font: { size: 11 }, precision: 0 }
                        }
                    }
                }
            });
        }

        document.querySelectorAll('.seg-btn').forEach(function (btn) {
            btn.addEventListener('click', function () {
                document.querySelectorAll('.seg-btn').forEach(function (b) { b.classList.remove('is-active'); });
                btn.classList.add('is-active');
                if (!trendChart) return;
                var n = parseInt(btn.getAttribute('data-period'), 10) || 7;
                trendChart.data.labels = TREND.labels.slice(-n);
                trendChart.data.datasets[0].data = TREND.soal.slice(-n);
                trendChart.data.datasets[1].data = TREND.hasil.slice(-n);
                trendChart.update();
            });
        });

        /* Donut komposisi mapel */
        var subjectEl = document.getElementById('subjectChart');
        if (subjectEl) {
            new Chart(subjectEl.getContext('2d'), {
                type: 'doughnut',
                data: {
                    labels: <?php echo json_encode(array_column($composition, 'nama'), JSON_UNESCAPED_UNICODE); ?>,
                    datasets: [{
                        data: <?php echo json_encode(array_column($composition, 'total')); ?>,
                        backgroundColor: <?php echo json_encode($chartColors); ?>,
                        borderWidth: 0,
                        hoverOffset: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '72%',
                    animation: reduceMotion ? false : { duration: 400 },
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: '#0F172A',
                            padding: 10,
                            cornerRadius: 8,
                            callbacks: {
                                label: function (ctx) {
                                    var total = ctx.dataset.data.reduce(function (a, b) { return a + b; }, 0);
                                    var pct = total ? Math.round((ctx.parsed / total) * 100) : 0;
                                    return ' ' + ctx.label + ': ' + ctx.parsed + ' soal (' + pct + '%)';
                                }
                            }
                        }
                    }
                }
            });
        }
    })();
    </script>
    <?php include '../assets/includes/admin_scripts.php'; ?>
    <?php include_once '../shared/footer.php'; ?>
</body>
</html>
