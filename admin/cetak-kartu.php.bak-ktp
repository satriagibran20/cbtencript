logActivity($_SESSION['user_id'], "Mencetak kartu ujian");

/**
 * [qrcard] Deteksi base URL aplikasi yang SEDANG DIPAKAI (tidak hardcode).
 * Mendukung Cloudflare / reverse proxy (X-Forwarded-Proto & X-Forwarded-Host)
 * serta instalasi di sub-folder.
 */
function getAppBaseUrl() {
    // Skema: header proxy lebih diutamakan, lalu HTTPS server, lalu port 443
    $scheme = 'http';
    if (!empty($_SERVER['HTTP_X_FORWARDED_PROTO'])) {
        $protoParts = explode(',', (string) $_SERVER['HTTP_X_FORWARDED_PROTO']);
        $proto = strtolower(trim($protoParts[0]));
        if ($proto === 'https' || $proto === 'http') {
            $scheme = $proto;
        }
    } elseif (!empty($_SERVER['HTTPS']) && strtolower((string) $_SERVER['HTTPS']) !== 'off') {
        $scheme = 'https';
    } elseif (isset($_SERVER['SERVER_PORT']) && (int) $_SERVER['SERVER_PORT'] === 443) {
        $scheme = 'https';
    }

    // Host: X-Forwarded-Host -> HTTP_HOST -> SERVER_NAME
    $host = '';
    foreach (array('HTTP_X_FORWARDED_HOST', 'HTTP_HOST', 'SERVER_NAME') as $hostKey) {
        if (!empty($_SERVER[$hostKey])) {
            $hostParts = explode(',', (string) $_SERVER[$hostKey]);
            $candidate = trim($hostParts[0]);
            if ($candidate !== '') {
                $host = $candidate;
                break;
            }
        }
    }
    // Buang karakter yang tidak valid, sisakan host:port
    $host = preg_replace('/[^A-Za-z0-9\.\-:\[\]]/', '', $host);

    // Path dasar aplikasi: /admin/cetak-kartu.php -> '' ; /app/admin/... -> '/app'
    $scriptName = str_replace('\\', '/', (string) (isset($_SERVER['SCRIPT_NAME']) ? $_SERVER['SCRIPT_NAME'] : ''));
    $basePath = rtrim(str_replace('\\', '/', dirname(dirname($scriptName))), '/');
    if ($basePath === '.' || $basePath === '/') {
        $basePath = '';
    }

    if ($host === '') {
        // Fallback (mis. dipanggil dari CLI): pakai setting bila ada
        $fallback = trim((string) getSetting('app_url', ''));
        return $fallback !== '' ? rtrim($fallback, '/') : '';
    }

    return $scheme . '://' . $host . $basePath;
}

/**
 * [qrcard] Bangun QR Code asli per peserta (SVG inline) berisi kredensial
 * + URL domain yang sedang dipakai.
 */
function buildStudentQrSvg($student, $baseUrl) {
    $payload = array(
        'username' => (string) $student['username'],
        'password' => (string) $student['display_password'],
        'url'      => (string) $baseUrl,
    );
    $data = json_encode($payload, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE);
    if ($data === false || $data === '') {
        $data = (string) $baseUrl;
    }

    try {
        $qr = SimpleQrCode::encodeText($data, SimpleQrCode::ECL_M);
        return $qr->toSvg(104, 3, '#111827', '#ffffff');
    } catch (Exception $e) {
        return '';
    }
}

// [qrcard] Base URL sekali hitung, dipakai semua kartu
$app_base_url = getAppBaseUrl();
?>

