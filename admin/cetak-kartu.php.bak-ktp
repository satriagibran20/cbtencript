$card_year = 'Tahun Pelajaran ' . $academic_year;
$card_color = getSetting('card_color', 'blue'); // Default color theme

// Function to get class names from class IDs
function getClassNames($conn, $kelasIds) {
    if (empty($kelasIds)) {
        return 'Tidak ada kelas';
    }
    
    // Split comma-separated IDs and clean them
    $ids = array_map('trim', explode(',', $kelasIds));
    $ids = array_filter($ids, function($id) {
        return !empty($id) && is_numeric($id);
    });
    
    if (empty($ids)) {
        return 'Tidak ada kelas';
    }
    
    // Create placeholders for prepared statement
    $placeholders = str_repeat('?,', count($ids) - 1) . '?';
    
    $query = "SELECT nama_kelas FROM classes WHERE id IN ($placeholders) ORDER BY nama_kelas";
    $stmt = $conn->prepare($query);
    $stmt->execute($ids);
    $classes = $stmt->fetchAll(PDO::FETCH_COLUMN);
    
    return !empty($classes) ? implode(', ', $classes) : 'Kelas tidak ditemukan';
}

// [kartufix] Filter kartu: kelas (kolom users.kelas bisa berisi banyak ID dipisah koma) + pencarian
$filter_kelas = (isset($_GET['kelas']) && is_scalar($_GET['kelas'])) ? preg_replace('/[^0-9]/', '', (string) $_GET['kelas']) : '';
$filter_q     = (isset($_GET['q']) && is_scalar($_GET['q'])) ? trim((string) $_GET['q']) : '';

$query = "SELECT u.id, u.username, u.nama, u.password, u.kelas,
          CASE
              WHEN u.plain_password IS NOT NULL AND u.plain_password != '' THEN u.plain_password
              ELSE '(Password tidak tersedia dalam bentuk plaintext)'
          END AS display_password
          FROM users u
          JOIN roles r ON u.role_id = r.id
          WHERE r.nama = 'peserta'";
$params = [];

if ($filter_kelas !== '') {
    $query .= " AND u.kelas REGEXP ?";
    $params[] = '(^|,)' . $filter_kelas . '(,|$)';
}
if ($filter_q !== '') {
    $query .= " AND (u.nama LIKE ? OR u.username LIKE ?)";
    $params[] = '%' . $filter_q . '%';
    $params[] = '%' . $filter_q . '%';
}

$query .= " ORDER BY u.kelas, u.nama";
$stmt = $conn->prepare($query);
$stmt->execute($params);
$students = $stmt->fetchAll(PDO::FETCH_ASSOC);

// [kartufix] Daftar kelas untuk dropdown filter
$kelas_list = $conn->query("SELECT id, nama_kelas FROM classes ORDER BY nama_kelas ASC")->fetchAll(PDO::FETCH_ASSOC);

// Add class names to each student
foreach ($students as &$student) {
    $student['nama_kelas'] = getClassNames($conn, $student['kelas']);
}
// WAJIB: putus referensi $student, kalau tidak loop berikutnya menimpa elemen terakhir
unset($student);

// Get color themes
$color_themes = [
