    <script>
        // Function to change theme color
        function changeTheme(theme, savePreference = false) {
            // Update all cards with the new theme
            const cards = document.querySelectorAll('.theme-card');
            const gradients = {
                'blue': 'linear-gradient(135deg, #0ea5e9 0%, #0c4a6e 100%)',
                'purple': 'linear-gradient(135deg, #8b5cf6 0%, #4c1d95 100%)',
                'green': 'linear-gradient(135deg, #10b981 0%, #064e3b 100%)',
                'red': 'linear-gradient(135deg, #ef4444 0%, #7f1d1d 100%)'
            };
            
            const textColors = {
                'blue': { class: 'text-primary-700', hex: '#0369a1' },
                'purple': { class: 'text-purple-700', hex: '#7e22ce' },
                'green': { class: 'text-green-700', hex: '#15803d' },
                'red': { class: 'text-red-700', hex: '#b91c1c' }
            };
            
            const accentColors = {
                'blue': { class: 'text-secondary-500', hex: '#d946ef' },
                'purple': { class: 'text-pink-500', hex: '#ec4899' },
                'green': { class: 'text-yellow-500', hex: '#eab308' },
                'red': { class: 'text-amber-500', hex: '#f59e0b' }
            };
            
            cards.forEach(card => {
                // Update card theme attribute
                card.setAttribute('data-theme', theme);
                
                // Update gradient background
                const headerEl = card.querySelector('.card-gradient');
                if (headerEl) {
                    headerEl.style.background = gradients[theme];
                }
                
                // Update text colors
                const textEls = card.querySelectorAll('.font-mono.font-medium');
                textEls.forEach(el => {
                    // Remove all text color classes
                    el.classList.remove('text-primary-700', 'text-purple-700', 'text-green-700', 'text-red-700');
                    // Add new text color class and inline style for printing
                    el.classList.add(textColors[theme].class);
                    el.style.color = textColors[theme].hex;
                });
                
                // Update accent colors
                const accentEls = card.querySelectorAll('.fa-info-circle');
                accentEls.forEach(el => {
                    // Remove all accent color classes
                    el.classList.remove('text-secondary-500', 'text-pink-500', 'text-yellow-500', 'text-amber-500');
                    // Add new accent color class and inline style for printing
                    el.classList.add(accentColors[theme].class);
                    el.style.color = accentColors[theme].hex;
                });
            });
            
            // Save preference if requested
            if (savePreference) {
                saveThemePreference(theme);
            }
        }
        
        // Function to save theme preference to database
        function saveThemePreference(theme) {
            // Create a form data object
            const formData = new FormData();
            formData.append('action', 'save_theme');
            formData.append('theme', theme);
            
            // Send AJAX request
            fetch('save_theme.php', {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // Show success message
                    const saveStatus = document.getElementById('saveStatus');
                    saveStatus.classList.remove('hidden');
                    setTimeout(() => {
                        saveStatus.classList.add('hidden');
                    }, 2000);
                }
            })
            .catch(error => {
                console.error('Error saving theme preference:', error);
            });
        }
        
        // Initialize with default theme
        document.addEventListener('DOMContentLoaded', function() {
            const defaultTheme = '<?php echo $card_color; ?>';
            changeTheme(defaultTheme);
        });
        
        // Function to print with current theme
        function printWithCurrentTheme() {
            // Short delay to ensure theme changes are applied
            setTimeout(() => {
                window.print();
            }, 300);
        }
    </script>
    
    <!-- Add some visual flair with a decorative element -->
    <div class="no-print fixed bottom-0 right-0 w-64 h-64 -mb-16 -mr-16 rounded-full bg-gradient-to-r from-blue-100 to-purple-100 opacity-30 z-0"></div>
    <div class="no-print fixed top-0 left-0 w-96 h-96 -mt-48 -ml-48 rounded-full bg-gradient-to-r from-green-100 to-yellow-100 opacity-20 z-0"></div>
    <?php include_once '../shared/footer.php'; ?>
</body>
</html>