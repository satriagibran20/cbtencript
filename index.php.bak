        .checks b { font-weight: 700; color: var(--ink); }

        .monitor {
            background: var(--surface);
            border: 1px solid var(--line);
            border-radius: var(--radius);
            box-shadow: var(--shadow-md);
            overflow: hidden;
        }

        .monitor-head {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 15px 18px;
            border-bottom: 1px solid #f1f3fa;
            font-size: .82rem;
            font-weight: 700;
            color: #334155;
        }

        .monitor-head .live {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #22c55e;
            box-shadow: 0 0 0 3px rgba(34, 197, 94, .18);
            flex: none;
        }

        .monitor-head span:last-child {
            margin-left: auto;
            font-size: .7rem;
            font-weight: 600;
            color: var(--subtle);
            text-transform: uppercase;
            letter-spacing: .06em;
        }

        .monitor-row {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 13px 18px;
            border-bottom: 1px solid #f6f7fb;
        }

        .monitor-row:last-child { border-bottom: 0; }

        .avatar {
            width: 30px;
            height: 30px;
            border-radius: 9px;
            background: linear-gradient(135deg, #eef0ff, #e0e4ff);
            color: #4f46e5;
            font-size: .72rem;
            font-weight: 800;
            display: grid;
            place-items: center;
            flex: none;
        }

        .monitor-row .who { min-width: 0; }

        .monitor-row .who b {
            display: block;
            font-size: .82rem;
            font-weight: 600;
            color: #1e293b;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .monitor-row .who small { font-size: .71rem; color: var(--subtle); }

        .tag {
            margin-left: auto;
            font-size: .68rem;
            font-weight: 700;
            padding: .22rem .5rem;
            border-radius: 999px;
            white-space: nowrap;
            flex: none;
        }

        .tag-ok { background: #ecfdf5; color: #047857; }
        .tag-warn { background: #fffbeb; color: #b45309; }
        .tag-off { background: #f1f5f9; color: #64748b; }

        /* ---------------- FAQ ---------------- */
        .faq { max-width: 780px; margin: 0 auto; display: grid; gap: 10px; }

        .faq details {
            background: var(--surface);
            border: 1px solid var(--line);
            border-radius: 13px;
            box-shadow: var(--shadow-sm);
            overflow: hidden;
            transition: border-color .2s ease;
        }

        .faq details[open] { border-color: #d5d8f5; }

        .faq summary {
            cursor: pointer;
            list-style: none;
            padding: 17px 20px;
            font-size: .92rem;
            font-weight: 600;
            color: #1e293b;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .faq summary::-webkit-details-marker { display: none; }

        .faq summary::after {
            content: '\f078';
            font-family: 'Font Awesome 6 Free';
            font-weight: 900;
            font-size: .62rem;
            color: var(--subtle);
            margin-left: auto;
            transition: transform .2s ease;
        }

        .faq details[open] summary::after { transform: rotate(180deg); }

        .faq .answer {
            padding: 0 20px 18px;
            font-size: .885rem;
            line-height: 1.72;
            color: var(--muted);
        }

        /* ---------------- CTA ---------------- */
        .cta {
            position: relative;
            overflow: hidden;
            border-radius: 22px;
            background: linear-gradient(120deg, #4f46e5 0%, #6366f1 46%, #7c3aed 100%);
            color: #fff;
            padding: 52px 48px;
            display: flex;
            align-items: center;
            gap: 36px;
            flex-wrap: wrap;
            box-shadow: 0 34px 70px -34px rgba(79, 70, 229, .7);
        }

        .cta::before {
            content: '';
            position: absolute;
            inset: 0;
            background:
                radial-gradient(420px 200px at 88% -20%, rgba(255, 255, 255, .26), transparent 70%),
                radial-gradient(340px 180px at 8% 120%, rgba(255, 255, 255, .14), transparent 70%);
            pointer-events: none;
        }

        .cta > * { position: relative; z-index: 1; }

        .cta h2 {
            font-size: clamp(1.4rem, 2.6vw, 1.85rem);
            font-weight: 800;
            line-height: 1.22;
        }

        .cta p {
            margin-top: 10px;
            font-size: .93rem;
            line-height: 1.6;
            color: rgba(255, 255, 255, .82);
            max-width: 32rem;
        }

        .cta .btn-white {
            background: #fff;
            color: #4338ca;
            box-shadow: 0 14px 30px -14px rgba(15, 23, 42, .55);
            margin-left: auto;
        }

        .cta .btn-white:hover {
            transform: translateY(-1px);
            box-shadow: 0 20px 34px -14px rgba(15, 23, 42, .6);
        }

        /* ---------------- Footer ---------------- */
        .site-footer {
            margin-top: 82px;
            background: #0b1120;
            color: #cbd5e1;
            padding: 56px 0 0;
        }

        .foot-grid {
            display: grid;
            grid-template-columns: 1.6fr 1fr 1fr 1.25fr;
            gap: 40px;
            padding-bottom: 42px;
        }

        .foot-brand { display: flex; align-items: center; gap: 11px; margin-bottom: 14px; }

        .foot-brand img {
            width: 34px;
            height: 34px;
            border-radius: 8px;
            object-fit: contain;
            background: rgba(255, 255, 255, .06);
            padding: 2px;
        }

        .foot-brand b {
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: .98rem;
            font-weight: 800;
            color: #fff;
            letter-spacing: -.01em;
        }

        .foot-about {
            font-size: .855rem;
            line-height: 1.72;
            color: #a3aec0;
            max-width: 22rem;
        }

        .foot-col h4 {
            font-size: .72rem;
            font-weight: 700;
            letter-spacing: .13em;
            text-transform: uppercase;
            color: #7f8da3;
            margin-bottom: 16px;
        }

        .foot-col ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 11px; }

        .foot-col a, .foot-col p {
            font-size: .855rem;
            color: #a3aec0;
            transition: color .15s ease;
        }

        .foot-col a:hover { color: #fff; }

        .foot-contact li {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            font-size: .855rem;
            line-height: 1.6;
            color: #a3aec0;
        }

        .foot-contact i { color: #6366f1; margin-top: 3px; font-size: .82rem; flex: none; }

        .foot-bottom {
            border-top: 1px solid rgba(148, 163, 184, .16);
            padding: 20px 0 26px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
            flex-wrap: wrap;
            font-size: .79rem;
            color: #8494a9;
        }

        .foot-bottom a { color: #a3aec0; }
        .foot-bottom a:hover { color: #fff; }

        /* ---------------- Reveal on scroll ---------------- */
        html.js [data-reveal] {
            opacity: 0;
            transform: translateY(16px);
            transition: opacity .6s ease, transform .6s cubic-bezier(.22, 1, .36, 1);
            will-change: opacity, transform;
        }

        html.js [data-reveal].in { opacity: 1; transform: none; }

        @media (prefers-reduced-motion: reduce) {
            html { scroll-behavior: auto; }
            html.js [data-reveal] { opacity: 1; transform: none; transition: none; }
            * { animation-duration: .01ms !important; transition-duration: .01ms !important; }
        }

        /* ---------------- Responsive ---------------- */
        @media (max-width: 980px) {
            .hero-grid { grid-template-columns: 1fr; gap: 52px; }
            .hero .lead { max-width: 40rem; }
            .mock-wrap { max-width: 520px; }
            .features { grid-template-columns: repeat(2, 1fr); }
            .split { grid-template-columns: 1fr; gap: 34px; }
            .steps::before { display: none; }
            .steps { grid-template-columns: 1fr; gap: 32px; }
            .foot-grid { grid-template-columns: 1fr 1fr; gap: 32px; }
        }

        @media (max-width: 860px) {
            .nav-links { display: none; }
            .nav-toggle { display: inline-flex; }
            .nav-actions .btn { padding: .68rem .9rem; }
            .nav-mobile.is-open { display: block; }
            .hero { padding: 44px 0 40px; }
            .section { padding: 58px 0; }
        }

        @media (max-width: 480px) {
            .brand-text strong { font-size: .82rem; }
            .brand-text small { display: none; }
            .brand img { width: 32px; height: 32px; }
        }

        @media (max-width: 640px) {
            .wrap { padding: 0 18px; }
            .stats { grid-template-columns: 1fr 1fr; }
            .stat { padding: 16px 12px; }
            .stat:nth-child(2) { border-right: 0; }
            .stat:nth-child(1), .stat:nth-child(2) { border-bottom: 1px solid #f1f3fa; }
            .stat b { font-size: 1.5rem; }
            .features { grid-template-columns: 1fr; }
            .mock-notes { grid-template-columns: 1fr; }
            .cta { padding: 34px 26px; }
            .cta .btn-white { margin-left: 0; width: 100%; }
            .foot-grid { grid-template-columns: 1fr; gap: 30px; }
            .foot-bottom { justify-content: flex-start; }
        }
    
        /* ===== Aplikasi Android mockup (layered fan, premium) ===== */
        .app-showcase { position: relative; overflow: hidden; }
        .app-showcase::before {
            content: ""; position: absolute; inset: 0;
            background: radial-gradient(70% 55% at 50% 6%, rgba(99,102,241,.18), transparent 70%);
            pointer-events: none;
        }
        .phone-stage {
            position: relative;
            max-width: 960px;
            height: 624px;
            margin: 26px auto 4px;
        }
        /* ambient glow behind the phones */
        .phone-stage::before {
            content: ""; position: absolute; left: 50%; top: 47%;
            width: 640px; height: 600px; transform: translate(-50%,-50%);
            background: radial-gradient(circle, rgba(99,102,241,.30), rgba(99,102,241,0) 62%);
            filter: blur(6px); z-index: 0; pointer-events: none;
        }
        /* --- phone body / bezel ("bingkai hp") --- */
        .device {
            position: relative;
            margin: 0;
            background: linear-gradient(155deg, #2a3346 0%, #11151f 55%, #05070c 100%);
            border: 2px solid #05070c;
            border-radius: 42px;
            padding: 14px 12px 18px;
            box-shadow:
                0 46px 80px -30px rgba(3,6,14,.92),
                0 0 0 2px rgba(255,255,255,.10) inset,
                0 0 0 4px rgba(0,0,0,.55),
                0 2px 0 rgba(255,255,255,.07) inset;
            pointer-events: none;
            z-index: 1;
        }
        /* physical side buttons (power / volume) */
        .device::before {
            content: ""; position: absolute; top: 118px; right: -4px;
            width: 4px; height: 66px; border-radius: 4px;
            background: linear-gradient(#20283a, #05070c);
            box-shadow: 0 0 0 1px rgba(0,0,0,.5);
            z-index: 2;
        }
        .device-screen {
            position: relative;
            border-radius: 30px;
            overflow: hidden;
            background: #0b1020;
            aspect-ratio: 9 / 19;
            line-height: 0;
            border: 1px solid rgba(0,0,0,.6);
            box-shadow: 0 0 0 1px rgba(0,0,0,.6) inset, 0 0 0 2px rgba(255,255,255,.05) inset;
        }
        .device-screen img { width: 100%; height: 100%; object-fit: cover; display: block; }
        /* notch / dynamic island */
        .device::after {
            content: ""; position: absolute; top: 20px; left: 50%;
            transform: translateX(-50%);
            width: 72px; height: 10px; border-radius: 99px;
            background: #04060c; box-shadow: inset 0 0 0 1px rgba(255,255,255,.16);
            z-index: 4;
        }
        /* home indicator bar at the bottom of the screen */
        .device-screen::after {
            content: ""; position: absolute; left: 50%; bottom: 9px;
            transform: translateX(-50%);
            width: 38%; height: 5px; border-radius: 99px;
            background: rgba(255,255,255,.55);
            z-index: 4;
        }
        .device-tag {
            position: absolute; bottom: 16px; left: 50%; transform: translateX(-50%);
            display: inline-flex; align-items: center; gap: 7px;
            background: rgba(13,18,33,.80); color: #eaf0fb;
            font-size: .7rem; font-weight: 700; letter-spacing: .03em;
            padding: 6px 14px; border-radius: 99px;
            border: 1px solid rgba(255,255,255,.14); white-space: nowrap;
            backdrop-filter: blur(6px);
            box-shadow: 0 10px 22px -12px rgba(0,0,0,.7);
        }
        .device-tag::before {
            content: ""; width: 6px; height: 6px; border-radius: 50%;
            background: #818cf8; box-shadow: 0 0 8px #818cf8;
        }
        /* soft reflection on the hero phone */
        .device-front .device-screen {
            -webkit-box-reflect: below 8px linear-gradient(transparent 60%, rgba(0,0,0,.30));
        }
        /* layering: center hero + angled phones tucked behind (like reference) */
        .device-front { position: relative; z-index: 5; width: 258px; margin: 0 auto; }
        .device-mid {
            position: absolute; top: 64px; width: 214px; z-index: 3; opacity: .96;
        }
        .device-mid.device-left  { left: 50%; margin-left: -107px; transform: translateX(-150px) rotate(-8deg); }
        .device-mid.device-right { left: 50%; margin-left: -107px; transform: translateX(150px)  rotate(8deg); }
        .device-back {
            position: absolute; top: 40px; width: 186px; z-index: 1; opacity: .8;
        }
        .device-back.device-left2  { left: 50%; margin-left: -93px; transform: translateX(-300px) rotate(-17deg); }
        .device-back.device-right2 { left: 50%; margin-left: -93px; transform: translateX(300px)  rotate(17deg); }
        @media (max-width: 900px) {
            .phone-stage {
                height: auto; display: flex; flex-wrap: wrap; gap: 20px;
                justify-content: center; max-width: 640px;
            }
            .phone-stage::before { display: none; }
            .device, .device-front, .device-mid, .device-back {
                position: relative !important; top: auto !important; left: auto !important;
                right: auto !important; margin: 0 !important; transform: none !important;
                opacity: 1 !important; width: 212px;
            }
            .device-front .device-screen { -webkit-box-reflect: none; }
        }
        @media (max-width: 560px) {
            .device, .device-front, .device-mid, .device-back { width: 176px; }
        }

    </style>
