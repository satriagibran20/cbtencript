<?php
require_once 'config/config.php';

// Redirect if already logged in
if (isLoggedIn()) {
    $role = $_SESSION['role'];
    switch ($role) {
        case 'admin':
            header('Location: admin/dashboard.php');
            break;
        case 'guru':
            header('Location: guru/dashboard.php');
            break;
        case 'peserta':
            header('Location: peserta/dashboard.php');
            break;
        default:
            header('Location: login.php');
    }
    exit();
}

// Maintenance mode
if (getSetting('maintenance_mode', '0') === '1') {
    header('Location: maintenance');
    exit();
}

// ---------------------------------------------------------------------------
// Angka ringkas untuk halaman publik.
// Dibungkus try/catch supaya landing page tetap tampil walau DB bermasalah,
// dan di-cache 5 menit agar tidak menambah beban pada setiap kunjungan.
// ---------------------------------------------------------------------------
$siteStats = ['soal' => 0, 'ujian' => 0, 'peserta' => 0, 'mapel' => 0];
try {
    $cachedStats = RedisCache::get('landing:stats');
    if (is_array($cachedStats) && isset($cachedStats['soal'])) {
        $siteStats = $cachedStats;
    } else {
        $db = new Database();
        $conn = $db->getConnection();

        $siteStats['soal']  = (int) $conn->query("SELECT COUNT(*) FROM questions")->fetchColumn();
        $siteStats['ujian'] = (int) $conn->query("SELECT COUNT(*) FROM exams")->fetchColumn();
        $siteStats['mapel'] = (int) $conn->query("SELECT COUNT(*) FROM subjects")->fetchColumn();
        $siteStats['peserta'] = (int) $conn->query(
            "SELECT COUNT(*) FROM users u
             JOIN roles r ON r.id = u.role_id
             WHERE r.nama = 'peserta'"
        )->fetchColumn();

        RedisCache::set('landing:stats', $siteStats, 300);
    }
} catch (Exception $e) {
    // biarkan nilai default 0
}

$appName  = getSetting('app_name', 'CBT');
$appLogo  = getSetting('app_logo', 'assets/img/logo.png');
$appFav   = getSetting('app_favicon', 'assets/img/favicon.png');
$appYear  = getSetting('academic_year', '');

if (!function_exists('h')) {
    function h($v) { return htmlspecialchars((string) $v, ENT_QUOTES, 'UTF-8'); }
}
?>
