                </div>
                <?php if (empty($announcements)): ?>
                    <div class="empty-state">
                        <i class="fas fa-bullhorn" aria-hidden="true"></i>
                        <p>Belum ada pengumuman aktif.</p>
                    </div>
                <?php else: ?>
                    <div class="ann-grid">
                        <?php foreach ($announcements as $ann): ?>
                            <article class="ann">
                                <div class="ann-top">
                                    <span class="ann-icon"><i class="fas fa-bullhorn" aria-hidden="true"></i></span>
                                    <span class="ann-date"><?php echo dash_tgl($ann['tanggal']); ?></span>
                                </div>
                                <h3><?php echo htmlspecialchars($ann['judul']); ?></h3>
                                <p><?php echo nl2br(htmlspecialchars(mb_strimwidth($ann['pesan'], 0, 160, '...'))); ?></p>
                            </article>
                        <?php endforeach; ?>
                    </div>
                <?php endif; ?>
            </section>

            <p class="dash-foot">Data diperbarui otomatis tiap 5 menit &middot; <?php echo getSetting('app_name', 'CBT SMK'); ?></p>
        </div>
    </div>
    </div>

    <script>
    (function () {
        if (typeof Chart === 'undefined') return;
        var TREND = {
            labels: <?php echo json_encode($labels, JSON_UNESCAPED_UNICODE); ?>,
            soal: <?php echo json_encode($soalSeries); ?>,
            hasil: <?php echo json_encode($hasilSeries); ?>
        };
        var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        /* Tren: bar soal + line hasil */
        var trendEl = document.getElementById('trendChart');
        var trendChart = null;
        if (trendEl) {
            trendChart = new Chart(trendEl.getContext('2d'), {
                type: 'bar',
                data: {
                    labels: TREND.labels.slice(-7),
                    datasets: [
                        {
                            type: 'bar',
                            label: 'Soal baru',
                            data: TREND.soal.slice(-7),
                            backgroundColor: 'rgba(99,102,241,.72)',
                            hoverBackgroundColor: '#5B5BD6',
                            borderRadius: 6,
                            maxBarThickness: 22,
                            yAxisID: 'y'
                        },
                        {
                            type: 'line',
                            label: 'Hasil ujian',
                            data: TREND.hasil.slice(-7),
                            borderColor: '#10B981',
                            backgroundColor: 'rgba(16,185,129,.10)',
                            fill: true,
                            tension: 0.4,
                            borderWidth: 2,
                            pointRadius: 2,
                            pointHoverRadius: 5,
                            pointBackgroundColor: '#10B981',
                            yAxisID: 'y1'
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    animation: reduceMotion ? false : { duration: 300 },
                    interaction: { mode: 'index', intersect: false },
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: '#0F172A',
                            padding: 10,
                            cornerRadius: 8,
                            titleFont: { size: 12, weight: '600' },
                            bodyFont: { size: 12 },
                            displayColors: true,
                            boxPadding: 4
                        }
                    },
                    scales: {
                        x: {
                            grid: { display: false },
                            border: { display: false },
                            ticks: { color: '#94A3B8', font: { size: 11 }, maxRotation: 0, autoSkipPadding: 10 }
                        },
                        y: {
                            beginAtZero: true,
                            border: { display: false },
                            grid: { color: '#EFF2F7' },
                            ticks: { color: '#94A3B8', font: { size: 11 }, precision: 0 }
                        },
                        y1: {
                            beginAtZero: true,
                            position: 'right',
                            border: { display: false },
                            grid: { display: false },
                            ticks: { color: '#94A3B8', font: { size: 11 }, precision: 0 }
                        }
                    }
                }
            });
        }

        document.querySelectorAll('.seg-btn').forEach(function (btn) {
            btn.addEventListener('click', function () {
                document.querySelectorAll('.seg-btn').forEach(function (b) { b.classList.remove('is-active'); });
                btn.classList.add('is-active');
                if (!trendChart) return;
                var n = parseInt(btn.getAttribute('data-period'), 10) || 7;
                trendChart.data.labels = TREND.labels.slice(-n);
                trendChart.data.datasets[0].data = TREND.soal.slice(-n);
                trendChart.data.datasets[1].data = TREND.hasil.slice(-n);
                trendChart.update();
            });
        });

        /* Donut status ujian */
        var statusEl = document.getElementById('statusChart');
        if (statusEl) {
            new Chart(statusEl.getContext('2d'), {
                type: 'doughnut',
                data: {
                    labels: ['Aktif', 'Selesai', 'Draft'],
                    datasets: [{
                        data: [<?php echo (int)$stats['active_exams']; ?>, <?php echo (int)$stats['completed_exams']; ?>, <?php echo (int)$stats['draft_exams']; ?>],
                        backgroundColor: <?php echo json_encode($chartColors); ?>,
                        borderWidth: 0,
                        hoverOffset: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '72%',
                    animation: reduceMotion ? false : { duration: 400 },
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: '#0F172A',
                            padding: 10,
                            cornerRadius: 8,
                            callbacks: {
                                label: function (ctx) {
                                    var total = ctx.dataset.data.reduce(function (a, b) { return a + b; }, 0);
                                    var pct = total ? Math.round((ctx.parsed / total) * 100) : 0;
                                    return ' ' + ctx.label + ': ' + ctx.parsed + ' ujian (' + pct + '%)';
                                }
                            }
                        }
                    }
                }
            });
        }
    })();

    /* Dropdown user dari sidebar guru */
    function toggleUserMenu() {
        var d = document.getElementById('userDropdown');
        if (d) d.classList.toggle('hidden');
    }
    function toggleNotifications() {
        var d = document.getElementById('notificationDropdown');
        if (d) d.classList.toggle('hidden');
    }
    </script>

