<?php
require_once '../config/config.php';
require_once '../config/cache_helpers.php';
requireRole('guru');

$db = new Database();
$conn = $db->getConnection();

/* ---------- Helper ---------- */
function dash_bulan($n) {
    $b = [1 => 'Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun', 'Jul', 'Agu', 'Sep', 'Okt', 'Nov', 'Des'];
    return $b[(int)$n] ?? '';
}
function dash_tgl($dt) {
    $t = strtotime($dt);
    if (!$t) return '-';
    return date('d', $t) . ' ' . dash_bulan(date('n', $t)) . ' ' . date('Y', $t);
}
function dash_relatif($dt) {
    $t = strtotime($dt);
    if (!$t) return '-';
    $d = time() - $t;
    if ($d < 60) return 'baru saja';
    if ($d < 3600) return floor($d / 60) . ' menit lalu';
    if ($d < 86400) return floor($d / 3600) . ' jam lalu';
    if ($d < 604800) return floor($d / 86400) . ' hari lalu';
    return dash_tgl($dt);
}
function dash_spark(array $values, $w = 92, $h = 30) {
    if (count($values) < 2) $values = [0, 0];
    $max = max($values);
    $min = min($values);
    $range = $max - $min;
    if ($range <= 0) $range = 1;
    $n = count($values);
    $pts = [];
    foreach ($values as $i => $v) {
        $x = round(($i / ($n - 1)) * $w, 1);
        $y = round($h - (($v - $min) / $range) * ($h - 5) - 2.5, 1);
        $pts[] = $x . ',' . $y;
    }
    $poly = implode(' ', $pts);
    $area = '0,' . $h . ' ' . $poly . ' ' . $w . ',' . $h;
    return '<svg class="spark" width="' . $w . '" height="' . $h . '" viewBox="0 0 ' . $w . ' ' . $h . '" fill="none" aria-hidden="true">'
        . '<polygon points="' . $area . '" fill="currentColor" opacity=".10"></polygon>'
        . '<polyline points="' . $poly . '" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></polyline>'
        . '</svg>';
}
function dash_activity_meta($text) {
    $t = mb_strtolower($text);
    if (strpos($t, 'login') !== false) return ['fa-right-to-bracket', 'indigo'];
    if (strpos($t, 'hapus') !== false) return ['fa-trash-can', 'rose'];
    if (strpos($t, 'soal') !== false) return ['fa-file-circle-plus', 'violet'];
    if (strpos($t, 'ujian') !== false) return ['fa-clipboard-check', 'emerald'];
    if (strpos($t, 'token') !== false) return ['fa-key', 'amber'];
    if (strpos($t, 'nilai') !== false || strpos($t, 'hasil') !== false) return ['fa-chart-simple', 'blue'];
    if (strpos($t, 'user') !== false || strpos($t, 'peserta') !== false) return ['fa-user', 'blue'];
    return ['fa-circle-info', 'slate'];
}

$guru_id = (int)($_SESSION['user_id'] ?? 0);

/* ---------- Semua mapel milik guru ---------- */
$stmt = $conn->prepare("SELECT id, nama FROM subjects WHERE guru_id = ? ORDER BY nama");
$stmt->execute([$guru_id]);
$subjects = $stmt->fetchAll(PDO::FETCH_ASSOC);
$subjectIds = array_map('intval', array_column($subjects, 'id'));

$subjectNames = array_column($subjects, 'nama');
$subjectLabel = $subjectNames ? implode(', ', $subjectNames) : '';

/* ---------- Data (cached 5 menit) ---------- */
$dash = cacheRemember("stats:guru:dashboard:v1:{$guru_id}", function () use ($conn, $subjectIds) {
    $s = [
        'total_questions' => 0, 'total_exams' => 0, 'active_exams' => 0, 'draft_exams' => 0,
        'completed_exams' => 0, 'total_students' => 0, 'total_results' => 0, 'avg_score' => 0.0,
        'ongoing' => 0,
    ];
    $series = ['soal' => [], 'hasil' => []];

    if (empty($subjectIds)) {
        return ['stats' => $s, 'series' => $series];
    }

    $ph = implode(',', array_fill(0, count($subjectIds), '?'));

    $one = function ($sql, $params) use ($conn) {
        $st = $conn->prepare($sql);
        $st->execute($params);
        return $st->fetchColumn();
    };

    $s['total_questions'] = (int)$one("SELECT COUNT(*) FROM questions WHERE subject_id IN ($ph)", $subjectIds);
    $s['total_exams']     = (int)$one("SELECT COUNT(*) FROM exams WHERE subject_id IN ($ph)", $subjectIds);
    $s['active_exams']    = (int)$one("SELECT COUNT(*) FROM exams WHERE subject_id IN ($ph) AND status = 'aktif'", $subjectIds);
    $s['draft_exams']     = (int)$one("SELECT COUNT(*) FROM exams WHERE subject_id IN ($ph) AND status = 'draft'", $subjectIds);
    $s['completed_exams'] = (int)$one("SELECT COUNT(*) FROM exams WHERE subject_id IN ($ph) AND status = 'selesai'", $subjectIds);

    $s['total_students'] = (int)$one(
        "SELECT COUNT(DISTINCT er.user_id) FROM exam_results er
         JOIN exams e ON e.id = er.exam_id WHERE e.subject_id IN ($ph)",
        $subjectIds
    );
    $s['total_results'] = (int)$one(
        "SELECT COUNT(*) FROM exam_results er
         JOIN exams e ON e.id = er.exam_id
         WHERE e.subject_id IN ($ph) AND er.status = 'selesai'",
        $subjectIds
    );
    $s['avg_score'] = (float)$one(
        "SELECT COALESCE(ROUND(AVG(er.nilai), 1), 0) FROM exam_results er
         JOIN exams e ON e.id = er.exam_id
         WHERE e.subject_id IN ($ph) AND er.status = 'selesai'",
        $subjectIds
    );
    $s['ongoing'] = (int)$one(
        "SELECT COUNT(*) FROM exam_sessions es
         JOIN exams e ON e.id = es.exam_id
         WHERE e.subject_id IN ($ph) AND es.is_active = 1",
        $subjectIds
    );

    $queries = [
        'soal'  => "SELECT DATE(q.created_at) d, COUNT(*) c FROM questions q
                    WHERE q.subject_id IN ($ph) AND q.created_at >= DATE_SUB(CURDATE(), INTERVAL 29 DAY)
                    GROUP BY DATE(q.created_at)",
        'hasil' => "SELECT DATE(er.created_at) d, COUNT(*) c FROM exam_results er
                    JOIN exams e ON e.id = er.exam_id
                    WHERE e.subject_id IN ($ph) AND er.created_at >= DATE_SUB(CURDATE(), INTERVAL 29 DAY)
                    GROUP BY DATE(er.created_at)",
    ];
    foreach ($queries as $key => $sql) {
        $series[$key] = [];
        $st = $conn->prepare($sql);
        $st->execute($subjectIds);
        foreach ($st as $r) {
            $series[$key][$r['d']] = (int)$r['c'];
        }
    }

    return ['stats' => $s, 'series' => $series];
}, 300);

$stats  = $dash['stats'];
$series = $dash['series'];

/* ---------- Susun deret 30 hari ---------- */
$labels = [];
$soalSeries = $hasilSeries = $examSeries = [];
for ($i = 29; $i >= 0; $i--) {
    $d = date('Y-m-d', strtotime("-$i days"));
    $labels[]      = date('d', strtotime($d)) . ' ' . dash_bulan(date('n', strtotime($d)));
    $soalSeries[]  = $series['soal'][$d] ?? 0;
    $hasilSeries[] = $series['hasil'][$d] ?? 0;
}
$last7 = function (array $a) { return array_slice($a, -7); };
$newSoal  = array_sum($last7($soalSeries));
$newHasil = array_sum($last7($hasilSeries));

/* ---------- Data live ---------- */
$recent_exams = [];
$activities   = [];
$announcements = [];

if (!empty($subjectIds)) {
    $ph = implode(',', array_fill(0, count($subjectIds), '?'));

    $st = $conn->prepare(
        "SELECT e.id, e.judul, e.kelas, e.status, e.waktu_mulai, e.token,
                COALESCE(s.nama, '-') AS subject,
                (SELECT COUNT(*) FROM exam_results er WHERE er.exam_id = e.id) AS participants
         FROM exams e LEFT JOIN subjects s ON s.id = e.subject_id
         WHERE e.subject_id IN ($ph)
         ORDER BY e.created_at DESC, e.id DESC LIMIT 6"
    );
    $st->execute($subjectIds);
    $recent_exams = $st->fetchAll(PDO::FETCH_ASSOC);

    $st = $conn->prepare(
        "SELECT l.*, u.nama FROM logs l LEFT JOIN users u ON u.id = l.user_id
         WHERE l.user_id = ? ORDER BY l.waktu DESC LIMIT 6"
    );
    $st->execute([$guru_id]);
    $activities = $st->fetchAll(PDO::FETCH_ASSOC);
}

$st = $conn->prepare(
    "SELECT * FROM announcements
     WHERE (target_role = 'guru' OR target_role IS NULL) AND is_active = 1
     ORDER BY tanggal DESC LIMIT 3"
);
$st->execute();
$announcements = $st->fetchAll(PDO::FETCH_ASSOC);

$statusMap = [
    'aktif'   => ['Aktif', 'aktif'],
    'selesai' => ['Selesai', 'selesai'],
    'draft'   => ['Draft', 'draft'],
];
$guruName = $_SESSION['nama'] ?? 'Guru';
$chartColors = ['#10B981', '#3B82F6', '#F59E0B'];
