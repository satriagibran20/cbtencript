<?php
declare(strict_types=1);

/**
 * Klien lisensi CBT.
 *
 * Alur:
 *   1. Admin memasukkan kunci lisensi di admin/license.php (tersimpan di tabel settings).
 *   2. Aplikasi memanggil server lisensi (satriatech.cbtmandiri.my.id) untuk verifikasi.
 *   3. Hasilnya di-cache di Redis (6 jam). Bila server tidak dapat dihubungi,
 *      hasil valid terakhir masih dipakai sampai 14 hari (grace period) agar
 *      ujian tidak mendadak berhenti karena gangguan jaringan.
 *   4. Selama lisensi tidak valid, seluruh aplikasi dialihkan ke /license.php
 *      kecuali halaman login dan halaman lisensi admin.
 */

const LICENSE_SERVER      = 'https://satriatech.cbtmandiri.my.id/api/verify.php';
const LICENSE_SECRET      = '7c32e99aa4975563296393528d0948ca365c654f8c4db471';
const LICENSE_TTL         = 21600;    // 6 jam
const LICENSE_GRACE       = 1209600;  // 14 hari
const LICENSE_APP_NAME    = 'CBT SATRIA';
const LICENSE_APP_VERSION = '1.0.0';
const LICENSE_CACHE_KEY   = 'license:state';

// ---------------------------------------------------------------------------
// Dasar
// ---------------------------------------------------------------------------
function license_setting(string $key, string $default = ''): string
{
    $v = getSetting($key, $default);
    return is_string($v) ? $v : (string) $v;
}

function license_normalize_key(string $key): string
{
    $key = strtoupper(trim($key));
    $key = preg_replace('/[^A-Z0-9]/', '', $key) ?? '';
    if (str_starts_with($key, 'SRT')) {
        $key = substr($key, 3);
    }
    $key = substr($key, 0, 12);
    return 'SRT-' . implode('-', str_split($key, 4));
}

function license_key(): string
{
    return license_normalize_key(license_setting('license_key'));
}

function license_domain(): string
{
    $host = (string) ($_SERVER['HTTP_HOST'] ?? '');
    $host = preg_replace('/:\d+$/', '', $host) ?? $host;
    return strtolower($host);
}

/**
 * Basis URL aplikasi ('' kalau dipasang di root domain, '/sub' kalau di subfolder).
 */
function app_base_url(): string
{
    static $base = null;
    if ($base !== null) {
        return $base;
    }

    $root = str_replace('\\', '/', dirname(__DIR__));
    $doc  = rtrim(str_replace('\\', '/', (string) ($_SERVER['DOCUMENT_ROOT'] ?? '')), '/');

    if ($doc !== '' && str_starts_with($root, $doc)) {
        $base = rtrim(substr($root, strlen($doc)), '/');
    } else {
        $base = '';
    }

    return $base;
}

function license_student_count(): int
{
    static $count = null;
    if ($count !== null) {
        return $count;
    }

    try {
        $db = new Database();
        $conn = $db->getConnection();
        $count = (int) $conn->query(
            "SELECT COUNT(*) FROM users u
             JOIN roles r ON r.id = u.role_id
             WHERE r.nama = 'peserta'"
        )->fetchColumn();
    } catch (Throwable $e) {
        $count = 0;
    }

    return $count;
}

// ---------------------------------------------------------------------------
// Tanda tangan
// ---------------------------------------------------------------------------
function license_sign(array $d): string
{
    $canon = implode('|', [
        (string) ($d['license_key'] ?? ''),
        (string) ($d['status'] ?? ''),
        !empty($d['valid']) ? '1' : '0',
        (string) (int) ($d['max_students'] ?? 0),
        (string) ($d['expires_at'] ?? ''),
        (string) ($d['school_name'] ?? ''),
    ]);

    return hash_hmac('sha256', $canon, LICENSE_SECRET);
}

// ---------------------------------------------------------------------------
// HTTP
// ---------------------------------------------------------------------------
function license_http_post(string $url, array $payload): ?array
{
    $json = json_encode($payload, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE);

    if (function_exists('curl_init')) {
        $ch = curl_init($url);
        curl_setopt_array($ch, [
            CURLOPT_POST           => true,
            CURLOPT_POSTFIELDS     => $json,
            CURLOPT_RETURNTRANSFER => true,
            CURLOPT_HTTPHEADER     => ['Content-Type: application/json', 'Accept: application/json'],
            CURLOPT_CONNECTTIMEOUT => 5,
            CURLOPT_TIMEOUT        => 10,
            CURLOPT_SSL_VERIFYPEER => true,
            CURLOPT_SSL_VERIFYHOST => 2,
            CURLOPT_FOLLOWLOCATION => false,
            CURLOPT_USERAGENT      => LICENSE_APP_NAME . '/' . LICENSE_APP_VERSION,
        ]);
        $body = curl_exec($ch);
        $code = (int) curl_getinfo($ch, CURLINFO_HTTP_CODE);
        curl_close($ch);

        if ($body === false || $code < 200 || $code >= 300) {
            return null;
        }

        $decoded = json_decode((string) $body, true);
        return is_array($decoded) ? $decoded : null;
    }

    $ctx = stream_context_create([
        'http' => [
            'method'        => 'POST',
            'header'        => "Content-Type: application/json\r\nAccept: application/json\r\n",
            'content'       => $json,
            'timeout'       => 10,
            'ignore_errors' => true,
        ],
        'ssl' => ['verify_peer' => true, 'verify_peer_name' => true],
    ]);

    $body = @file_get_contents($url, false, $ctx);
    if ($body === false) {
        return null;
    }

    $decoded = json_decode($body, true);
    return is_array($decoded) ? $decoded : null;
}

// ---------------------------------------------------------------------------
// Verifikasi
// ---------------------------------------------------------------------------
/**
 * Panggil server lisensi.
 * @return array|null null kalau server tidak dapat dihubungi.
 */
function license_verify(): ?array
{
    $key = license_key();

    if ($key === 'SRT----' || strlen(preg_replace('/[^A-Z0-9]/', '', $key)) < 15) {
        return [
            'ok'         => false,
            'reason'     => 'missing',
            'message'    => 'Kunci lisensi belum diisi.',
            'data'       => [],
            'fetched_at' => time(),
            'stale'      => false,
        ];
    }

    $resp = license_http_post(LICENSE_SERVER, [
        'license_key'   => $key,
        'domain'        => license_domain(),
        'student_count' => license_student_count(),
        'app_name'      => LICENSE_APP_NAME,
        'app_version'   => LICENSE_APP_VERSION,
    ]);

    if ($resp === null || empty($resp['data']) || !is_array($resp['data'])) {
        return null;
    }

    $data = $resp['data'];

    // Tolak balasan yang tidak ditandatangani server resmi
    if (!isset($resp['sig']) || !hash_equals(license_sign($data), (string) $resp['sig'])) {
        return [
            'ok'         => false,
            'reason'     => 'bad_signature',
            'message'    => 'Balasan server lisensi tidak valid.',
            'data'       => $data,
            'fetched_at' => time(),
            'stale'      => false,
        ];
    }

    return [
        'ok'         => !empty($data['valid']),
        'reason'     => (string) ($data['status'] ?? 'unknown'),
        'message'    => (string) ($data['message'] ?? ''),
        'data'       => $data,
        'fetched_at' => time(),
        'stale'      => false,
    ];
}

// ---------------------------------------------------------------------------
// State (cache + grace)
// ---------------------------------------------------------------------------
function license_state(bool $force = false): array
{
    static $memo = null;
    if ($memo !== null && !$force) {
        return $memo;
    }

    $cached = null;
    try {
        $c = RedisCache::get(LICENSE_CACHE_KEY);
        if (is_array($c) && isset($c['fetched_at'])) {
            $cached = $c;
        }
    } catch (Throwable $e) {
        $cached = null;
    }

    // Masih segar -> pakai cache
    if (!$force && $cached !== null && (time() - (int) $cached['fetched_at']) < LICENSE_TTL) {
        return $memo = $cached;
    }

    $fresh = license_verify();

    if ($fresh !== null) {
        try {
            RedisCache::set(LICENSE_CACHE_KEY, $fresh, LICENSE_GRACE);
        } catch (Throwable $e) {
            // cache opsional
        }
        return $memo = $fresh;
    }

    // Server tidak dapat dihubungi
    if ($cached !== null && !empty($cached['ok'])) {
        $age = time() - (int) $cached['fetched_at'];
        if ($age <= LICENSE_GRACE) {
            $cached['stale'] = true;
            $cached['message'] = 'Server lisensi tidak dapat dihubungi. Memakai verifikasi terakhir '
                . date('d/m/Y H:i', (int) $cached['fetched_at']) . '.';
            return $memo = $cached;
        }
    }

    return $memo = [
        'ok'         => false,
        'reason'     => 'unreachable',
        'message'    => 'Server lisensi tidak dapat dihubungi dan belum ada verifikasi yang tersimpan.',
        'data'       => $cached['data'] ?? [],
        'fetched_at' => $cached['fetched_at'] ?? 0,
        'stale'      => true,
    ];
}

// ---------------------------------------------------------------------------
// Gate
// ---------------------------------------------------------------------------
function license_is_blocked_script(): bool
{
    $script = str_replace('\\', '/', (string) ($_SERVER['SCRIPT_NAME'] ?? ''));
    $rel    = substr($script, strlen(app_base_url()));
    $rel    = '/' . ltrim($rel, '/');

    $allowed = [
        '/license.php',
        '/admin/license.php',
        '/login.php',
        '/logout.php',
        '/maintenance.php',
        '/maintenance',
        '/install.php',
    ];

    foreach ($allowed as $a) {
        if ($rel === $a || str_ends_with($rel, $a)) {
            return true;
        }
    }

    return false;
}

/**
 * Hentikan akses kalau lisensi tidak valid.
 * Dipanggil otomatis dari config/config.php.
 */
function license_gate(): void
{
    if (PHP_SAPI === 'cli') {
        return;
    }

    $state = license_state();
    if (!empty($state['ok'])) {
        return;
    }

    if (license_is_blocked_script()) {
        return;
    }

    $script = str_replace('\\', '/', (string) ($_SERVER['SCRIPT_NAME'] ?? ''));

    // Endpoint API -> balas JSON, jangan redirect
    if (str_contains($script, '/api/')) {
        http_response_code(403);
        header('Content-Type: application/json; charset=utf-8');
        echo json_encode([
            'success' => false,
            'message' => 'Lisensi tidak aktif: ' . ($state['message'] ?? 'lisensi tidak valid'),
            'license' => [
                'status'  => $state['reason'] ?? 'invalid',
                'message' => $state['message'] ?? '',
            ],
        ], JSON_UNESCAPED_UNICODE);
        exit();
    }

    header('Location: ' . app_base_url() . '/license.php');
    exit();
}

// ---------------------------------------------------------------------------
// Kuota siswa
// ---------------------------------------------------------------------------
/**
 * Cek apakah masih boleh menambah $add siswa.
 * @return array{allowed:bool, used:int, max:int, message:string}
 */
function license_quota_check(int $add = 1): array
{
    $state = license_state();

    // Kalau lisensi bermasalah, biarkan gate yang menangani
    if (empty($state['ok'])) {
        return ['allowed' => false, 'used' => 0, 'max' => 0, 'message' => 'Lisensi tidak aktif.'];
    }

    $max  = (int) ($state['data']['max_students'] ?? 0);
    $used = license_student_count();

    if ($max > 0 && ($used + $add) > $max) {
        return [
            'allowed' => false,
            'used'    => $used,
            'max'     => $max,
            'message' => 'Kuota siswa pada lisensi sudah penuh (' . $used . ' dari ' . $max . '). '
                       . 'Hubungi penyedia layanan untuk menambah kuota.',
        ];
    }

    return ['allowed' => true, 'used' => $used, 'max' => $max, 'message' => ''];
}

/**
 * Apakah role_id ini role peserta?
 */
function license_role_is_peserta(int $roleId): bool
{
    static $pesertaId = null;

    if ($pesertaId === null) {
        try {
            $db = new Database();
            $conn = $db->getConnection();
            $pesertaId = (int) $conn->query("SELECT id FROM roles WHERE nama = 'peserta' LIMIT 1")->fetchColumn();
        } catch (Throwable $e) {
            $pesertaId = 0;
        }
    }

    return $pesertaId > 0 && $roleId === $pesertaId;
}
