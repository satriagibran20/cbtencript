<?php
require_once '../config/config.php';
requireRole('peserta');

$db = new Database();
$conn = $db->getConnection();

// Get student's exam results
$query = "SELECT er.*, e.judul, e.durasi, e.bobot_total, s.nama as subject_name, u.nama as guru_name
          FROM exam_results er 
          JOIN exams e ON er.exam_id = e.id 
          JOIN subjects s ON e.subject_id = s.id 
          JOIN users u ON s.guru_id = u.id 
          WHERE er.user_id = ? 
          ORDER BY er.created_at DESC";
$stmt = $conn->prepare($query);
$stmt->execute([$_SESSION['user_id']]);
$results = $stmt->fetchAll(PDO::FETCH_ASSOC);

// Get statistics
$total_exams = count($results);
$completed_exams = count(array_filter($results, function($r) { return $r['status'] === 'selesai'; }));
$average_score = $total_exams > 0 ? array_sum(array_column($results, 'nilai')) / $total_exams : 0;
?>

