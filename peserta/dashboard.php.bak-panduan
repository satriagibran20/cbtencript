<?php
// Enable error logging
error_reporting(E_ALL);
ini_set('display_errors', 0);
ini_set('log_errors', 1);

// Start output buffering to catch any errors
ob_start();

try {
    if (!file_exists('../config/config.php')) {
        throw new Exception("Config file not found");
    }
    
    require_once '../config/config.php';
    
    // Check if session is started
    if (session_status() === PHP_SESSION_NONE) {
        @session_start();
    }
    
    // Check if user is logged in
    if (!isset($_SESSION['user_id']) || empty($_SESSION['user_id'])) {
        header('Location: ../login.php');
        exit();
    }
    
    // Check role
    if (!isset($_SESSION['role']) || $_SESSION['role'] !== 'peserta') {
        header('Location: ../login.php');
        exit();
    }

    $db = new Database();
    if (!$db) {
        throw new Exception("Database class not found");
    }
    
    $conn = $db->getConnection();
    if (!$conn) {
        throw new Exception("Database connection failed");
    }
    
    // Clear output buffer if everything is OK
    ob_end_clean();
    
} catch (Exception $e) {
    ob_end_clean();
    error_log("Dashboard initialization error: " . $e->getMessage());
    error_log("Stack trace: " . $e->getTraceAsString());
    error_log("File: " . __FILE__ . " Line: " . __LINE__);
    http_response_code(500);
    die("Terjadi kesalahan sistem. Silakan hubungi administrator.");
}

// Build regex to match any of the participant's classes against exams.kelas (CSV of class IDs)
$userKelasRaw = isset($_SESSION['kelas']) ? (string)$_SESSION['kelas'] : '';
$tokens = array_filter(array_map('trim', explode(',', $userKelasRaw)));
$kelasIds = [];
$kelasNames = [];
foreach ($tokens as $t) {
	if (preg_match('/^\d+$/', $t)) { $kelasIds[] = $t; }
	else { $kelasNames[] = $t; }
}
$kelasRegexId = !empty($kelasIds) ? '(^|,)(' . implode('|', $kelasIds) . ')(,|$)' : '';
$escapedNames = [];
foreach ($kelasNames as $n) { if ($n !== '') { $escapedNames[] = preg_quote($n, '/'); } }
$kelasRegexName = !empty($escapedNames) ? '(^|,)(' . implode('|', $escapedNames) . ')(,|$)' : '';

// Also map names<->ids via classes to maximize compatibility
try {
	if (!empty($kelasNames)) {
		$stmtMap = $conn->prepare("SELECT id FROM classes WHERE nama_kelas IN (" . implode(',', array_fill(0, count($kelasNames), '?')) . ")");
		$stmtMap->execute($kelasNames);
		$mappedIds = $stmtMap->fetchAll(PDO::FETCH_COLUMN);
		if (!empty($mappedIds)) {
			$kelasIds = array_unique(array_merge($kelasIds, array_map('strval', $mappedIds)));
			$kelasRegexId = '(^|,)(' . implode('|', $kelasIds) . ')(,|$)';
		}
	}
	if (!empty($kelasIds)) {
		$stmtMap2 = $conn->prepare("SELECT nama_kelas FROM classes WHERE id IN (" . implode(',', array_fill(0, count($kelasIds), '?')) . ")");
		$stmtMap2->execute($kelasIds);
		$mappedNames = $stmtMap2->fetchAll(PDO::FETCH_COLUMN);
		if (!empty($mappedNames)) {
			$escaped = [];
			foreach ($mappedNames as $mn) { $escaped[] = preg_quote($mn, '/'); }
			$kelasRegexName = '(^|,)(' . implode('|', $escaped) . ')(,|$)';
		}
	}
} catch (Exception $e) {
	error_log("Error mapping kelas: " . $e->getMessage());
	// Continue with empty arrays if mapping fails
}

// Build WHERE clause snippet and params for class matching (IDs or Names)
$kelasWhere = '';
$kelasParams = [];
if ($kelasRegexId && $kelasRegexName) {
	$kelasWhere = "(e.kelas REGEXP ? OR e.kelas REGEXP ?)";
	$kelasParams = [$kelasRegexId, $kelasRegexName];
} elseif ($kelasRegexId) {
	$kelasWhere = "(e.kelas REGEXP ?)";
	$kelasParams = [$kelasRegexId];
} elseif ($kelasRegexName) {
	$kelasWhere = "(e.kelas REGEXP ?)";
	$kelasParams = [$kelasRegexName];
} else {
	$kelasWhere = "(1=0)"; // no classes
}

// Fetch class map id => nama_kelas for rendering names
$classMap = [];
try {
	$stmtClass = $conn->prepare("SELECT id, nama_kelas FROM classes");
	$stmtClass->execute();
	while ($row = $stmtClass->fetch(PDO::FETCH_ASSOC)) {
		$classMap[(string)$row['id']] = $row['nama_kelas'];
	}
} catch (Exception $e) {
	error_log("Error fetching class map: " . $e->getMessage());
	// Continue with empty classMap if fetch fails
}

// Helper to convert CSV of IDs to CSV of names
function renderClassNames($csvIds, $classMap) {
	$ids = array_filter(array_map('trim', explode(',', (string)$csvIds)));
	$names = [];
	foreach ($ids as $id) {
		if (isset($classMap[$id])) {
			$names[] = $classMap[$id];
		}
	}
	return !empty($names) ? htmlspecialchars(implode(', ', $names)) : htmlspecialchars((string)$csvIds);
}

// Get active exams (currently available) for student's class
$active_exams = [];
try {
    $query = "SELECT e.*, s.nama as subject_name, COALESCE(u.nama, 'Tidak Diketahui') as guru_name 
              FROM exams e 
              JOIN subjects s ON e.subject_id = s.id 
              LEFT JOIN users u ON s.guru_id = u.id 
              WHERE $kelasWhere AND e.status = 'aktif' 
              AND e.waktu_mulai <= NOW() AND e.waktu_selesai >= NOW()
              ORDER BY e.waktu_mulai ASC";
    $stmt = $conn->prepare($query);
    if ($stmt) {
        $stmt->execute($kelasParams);
        $active_exams = $stmt->fetchAll(PDO::FETCH_ASSOC);
    }
} catch (PDOException $e) {
    error_log("Error fetching active exams: " . $e->getMessage());
    error_log("Query: " . $query);
    error_log("Params: " . print_r($kelasParams, true));
    $active_exams = [];
} catch (Exception $e) {
    error_log("Error fetching active exams: " . $e->getMessage());
    $active_exams = [];
}

// Get upcoming exams for student's class
$upcoming_exams = [];
try {
    $query = "SELECT e.*, s.nama as subject_name, COALESCE(u.nama, 'Tidak Diketahui') as guru_name 
              FROM exams e 
              JOIN subjects s ON e.subject_id = s.id 
              LEFT JOIN users u ON s.guru_id = u.id 
              WHERE $kelasWhere AND e.status = 'aktif' 
              AND e.waktu_mulai > NOW()
              ORDER BY e.waktu_mulai ASC";
    $stmt = $conn->prepare($query);
    if ($stmt) {
        $stmt->execute($kelasParams);
        $upcoming_exams = $stmt->fetchAll(PDO::FETCH_ASSOC);
    }
} catch (PDOException $e) {
    error_log("Error fetching upcoming exams: " . $e->getMessage());
    error_log("Query: " . $query);
    $upcoming_exams = [];
} catch (Exception $e) {
    error_log("Error fetching upcoming exams: " . $e->getMessage());
    $upcoming_exams = [];
}

// Get student's exam history
$exam_history = [];
try {
    $query = "SELECT er.*, e.judul, s.nama as subject_name 
              FROM exam_results er 
              JOIN exams e ON er.exam_id = e.id 
              JOIN subjects s ON e.subject_id = s.id 
              WHERE er.user_id = ? 
              ORDER BY er.created_at DESC";
    $stmt = $conn->prepare($query);
    $stmt->execute([$_SESSION['user_id']]);
    $exam_history = $stmt->fetchAll(PDO::FETCH_ASSOC);
} catch (Exception $e) {
    error_log("Error fetching exam history: " . $e->getMessage());
    $exam_history = [];
}

// Get completed exams (past exams that are no longer active)
$completed_exams = [];
try {
    $query = "SELECT e.*, s.nama as subject_name, COALESCE(u.nama, 'Tidak Diketahui') as guru_name, 
              CASE WHEN er.id IS NOT NULL THEN 1 ELSE 0 END as has_taken
              FROM exams e 
              JOIN subjects s ON e.subject_id = s.id 
              LEFT JOIN users u ON s.guru_id = u.id 
              LEFT JOIN exam_results er ON e.id = er.exam_id AND er.user_id = ?
              WHERE $kelasWhere AND e.waktu_selesai < NOW()
              ORDER BY e.waktu_selesai DESC";
    $stmt = $conn->prepare($query);
    if ($stmt) {
        $stmt->execute(array_merge([$_SESSION['user_id']], $kelasParams));
        $completed_exams = $stmt->fetchAll(PDO::FETCH_ASSOC);
    }
} catch (PDOException $e) {
    error_log("Error fetching completed exams: " . $e->getMessage());
    error_log("Query: " . $query);
    $completed_exams = [];
} catch (Exception $e) {
    error_log("Error fetching completed exams: " . $e->getMessage());
    $completed_exams = [];
}

// Get announcements for students
$announcements = [];
try {
    $query = "SELECT a.*, u.nama as pengirim_name FROM announcements a 
              LEFT JOIN users u ON a.pengirim = u.id
              WHERE (a.target_role = 'peserta' OR a.target_role IS NULL) 
              AND a.is_active = 1 
              ORDER BY a.tanggal DESC LIMIT 5";
    $stmt = $conn->prepare($query);
    $stmt->execute();
    $announcements = $stmt->fetchAll(PDO::FETCH_ASSOC);
} catch (Exception $e) {
    error_log("Error fetching announcements: " . $e->getMessage());
    $announcements = [];
}
