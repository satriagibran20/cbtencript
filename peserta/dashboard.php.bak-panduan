                            </button>
                            <button type="submit" 
                                    class="w-full sm:w-auto px-6 py-3 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white rounded-xl transition-all duration-300 font-medium flex items-center justify-center shadow-lg hover:shadow-blue-500/25">
                                <i class="fas fa-play mr-2"></i>Mulai Ujian
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Fungsi untuk menampilkan dropdown notifikasi
        function toggleNotificationDropdown() {
            const dropdown = document.getElementById('notificationDropdown');
            dropdown.classList.toggle('hidden');
        }

        // Fungsi untuk menampilkan dropdown user
        function toggleUserMenu() {
            const dropdown = document.getElementById('userDropdown');
            dropdown.classList.toggle('hidden');
        }

        function verifyAndStartExam(formData) {
            fetch('verify_token.php', {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    window.location.href = `exam.php?id=${data.exam_id}`;
                } else {
                    Swal.fire('Error!', data.message, 'error');
                }
            })
            .catch(error => {
                Swal.fire('Error!', 'Terjadi kesalahan sistem', 'error');
            });
        }

        function startExam(examId, examTitle) {
            <?php if (getSetting('token_required', '1') === '1'): ?>
            document.getElementById('examId').value = examId;
            document.getElementById('examTitle').textContent = examTitle;
            document.getElementById('tokenModal').classList.remove('hidden');
            <?php else: ?>
            const formData = new FormData();
            formData.append('exam_id', examId);
            verifyAndStartExam(formData);
            <?php endif; ?>
        }

        function closeTokenModal() {
            document.getElementById('tokenModal').classList.add('hidden');
            document.getElementById('tokenForm').reset();
        }

        function toggleChat() {
            const chatBox = document.getElementById('chatBox');
            chatBox.classList.toggle('hidden');
        }

        function sendMessage() {
            const input = document.getElementById('chatInput');
            const message = input.value.trim();
            
            if (message) {
                // Add message to chat (implement WebSocket here)
                const messagesDiv = document.getElementById('chatMessages');
                const messageDiv = document.createElement('div');
                messageDiv.className = 'bg-blue-100 p-2 rounded-lg';
                messageDiv.innerHTML = `<p class="text-sm">${message}</p><p class="text-xs text-gray-500">Sekarang</p>`;
                messagesDiv.appendChild(messageDiv);
                messagesDiv.scrollTop = messagesDiv.scrollHeight;
                
                input.value = '';
            }
        }
        
        //ucapan
        function updateGreeting() {
            const hour = new Date().getHours();
            let greetingMessage = "";

            if (hour >= 5 && hour < 12) {
                greetingMessage = "Selamat Pagi";
            } else if (hour >= 12 && hour < 15) {
                greetingMessage = "Selamat Siang";
            } else if (hour >= 15 && hour < 19) {
                greetingMessage = "Selamat Sore";
            } else {
                greetingMessage = "Selamat Malam!";
            }

            // Menampilkan ucapan di elemen dengan id "timeOfDayMessage"
            document.getElementById("timeOfDayMessage").innerText = greetingMessage;
        }

        // Panggil fungsi untuk memperbarui ucapan
        updateGreeting();

        // Token form submission
        document.getElementById('tokenForm').addEventListener('submit', function(e) {
            e.preventDefault();
            const formData = new FormData(this);
            verifyAndStartExam(formData);
        });

        // Update token input handler
        document.getElementById('examToken').addEventListener('input', function(e) {
            let value = this.value;
            // Remove spaces and non-alphanumeric characters
            value = value.replace(/[^A-Z0-9]/gi, '');
            // Convert to uppercase
            value = value.toUpperCase();
            // Limit to 6 characters
            value = value.substring(0, 6);
            this.value = value;
        });

        // Close modals when clicking outside
        document.getElementById('tokenModal').addEventListener('click', function(e) {
            if (e.target === this) {
                closeTokenModal();
            }
        });

        // Enter key for chat
        const chatInput = document.getElementById('chatInput');
        if (chatInput) {
            chatInput.addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    sendMessage();
                }
            });
        }
    </script>
    
    <!-- Smartsupp Live Chat script -->
    <script type="text/javascript">
    var _smartsupp = _smartsupp || {};
    _smartsupp.key = '<?php echo getSetting('smartsupp_key', '165a218a36ed3f2573a2ad63ac8c36ab3876814f'); ?>';
    // Set visitor name from PHP session
    _smartsupp.sitePlatform = "<?php echo getSetting('app_name', 'SMK Pasundan 2 Cianjur'); ?>";
    _smartsupp.userName = "<?php echo $_SESSION['nama']; ?>"; 
    _smartsupp.userEmail = "<?php echo $_SESSION['username'] ?? ''; ?>";
    _smartsupp.variables = {
        "role": "<?php echo $_SESSION['role']; ?>",
        "kelas": "<?php echo $_SESSION['kelas']; ?>"
    };

    window.smartsupp||(function(d) {
        var s,c,o=smartsupp=function(){ o._.push(arguments)};o._=[];
        s=d.getElementsByTagName('script')[0];c=d.createElement('script');
        c.type='text/javascript';c.charset='utf-8';c.async=true;
        c.src='https://www.smartsuppchat.com/loader.js?';s.parentNode.insertBefore(c,s);
    })(document);

    // Set name after loading
    smartsupp('name', "<?php echo $_SESSION['nama']; ?>");
    </script>
<script>
// Tampilkan popup pengumuman saat halaman dimuat
window.addEventListener('load', function() {
    const modal = document.getElementById('announcementModal');
    const hasAnnouncements = <?php echo !empty($announcements) ? 'true' : 'false'; ?>;
    const isClosed = localStorage.getItem('announcementClosed');
    
    if (modal && hasAnnouncements) {
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.body.classList.add('overflow-hidden');
    }
});

// Fungsi tutup popup
function closeAnnouncement() {
    const modal = document.getElementById('announcementModal');
    if (modal) {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        document.body.classList.remove('overflow-hidden');
        
    }
}

// Tutup popup ketika klik di luar area
window.addEventListener('click', function(event) {
    const modal = document.getElementById('announcementModal');
    if (event.target === modal) {
        closeAnnouncement();
    }
});
</script>
</body>
</html>