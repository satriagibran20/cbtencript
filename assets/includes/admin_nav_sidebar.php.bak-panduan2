<script>
    // Fallback untuk halaman yang tidak mendefinisikan toggleUserMenu sendiri.
    // Halaman yang punya definisi sendiri akan menimpanya (dideklarasikan setelah ini).
    if (typeof window.toggleUserMenu !== 'function') {
        window.toggleUserMenu = function () {
            var d = document.getElementById('userDropdown');
            if (d) d.classList.toggle('hidden');
        };
    }
    document.addEventListener('click', function (e) {
        var d = document.getElementById('userDropdown');
        if (!d || d.classList.contains('hidden')) return;
        if (!e.target.closest('#userDropdown') &&
            !e.target.closest('button[onclick*="toggleUserMenu"]')) {
            d.classList.add('hidden');
        }
    });
</script>
